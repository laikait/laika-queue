{
    "name": "laikait/laika-queue",
    "description": "Queue package for the Laika PHP MVC Framework — database, Redis, and JSON drivers with a signal-aware worker.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laika",
        "queue",
        "jobs",
        "worker",
        "php",
        "framework"
    ],
    "authors": [
        {
            "name": "Laika IT",
            "email": "strblackhawk@gmail.com"
        },
        {
            "name": "Showket Ahmed",
            "email": "riyadhtayf@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-pdo": "*"
    },
    "require-dev": {
        "composer/composer": "^2.0",
        "squizlabs/php_codesniffer": "^4.0.2",
        "phpcompatibility/php-compatibility": "dev-develop",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.1"
    },
    "suggest": {
        "ext-redis": "Required to use RedisDriver",
        "ext-pcntl": "Enables graceful shutdown and per-job timeout in Worker (Linux/macOS only)",
        "ext-posix": "Required alongside pcntl for signal handling (Linux/macOS only)"
    },
    "autoload": {
        "psr-4": {
            "Laika\\Queue\\": "src/"
        }
    },
    "bin": [
        "bin/worker"
    ],
    "minimum-stability": "stable",
    "extra": {
        "laika": {
            "resources": {
                "models": {
                    "path": "src/Model",
                    "namespace": "Laika\\Queue\\Model"
                },
                "schemas": {
                    "path": "src/Schema",
                    "namespace": "Laika\\Queue\\Schema",
                    "contract": "Laika\\Core\\Abstracts\\SchemaAbstract"
                }
            }
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "compat": "phpcs --standard=phpcs.xml --report=full"
    }
}
