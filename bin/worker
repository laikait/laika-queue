#!/usr/bin/env php
<?php

use Laika\Queue\Worker;
use Laika\Queue\Abstracts\Job;
use Laika\Queue\Driver\DatabaseDriver;
use Laika\Queue\Driver\DatabaseFailedJobProvider;
use Laika\Model\Connection;

/**
 * Resolve APP_PATH (the Laika project root).
 *
 * This file runs in three different contexts:
 *
 *  1. Local install, direct call — vendor/laikait/laika-queue/bin/worker,
 *     or Composer's generated vendor/bin/worker proxy (a plain include, so
 *     __DIR__ here is unaffected either way). 4 levels up from bin/ is the
 *     app root, where lf-boot/app.php lives.
 *
 *  2. Local install, project-root proxy — the `worker` executable
 *     QueuePlugin generates in the project root on every `composer
 *     install`/`update`. That proxy just requires this file directly, so
 *     it still resolves to case 1 above.
 *
 *  3. Global install — invoked as `worker` from anywhere on the system
 *     after `composer global require laikait/laika-queue`. This file then
 *     lives under the global Composer home, nowhere near the project, so
 *     the root is instead resolved by walking up from the current working
 *     directory until a Laika project (lf-boot/app.php) is found.
 */
if (!defined('APP_PATH')) {
    $local = realpath(__DIR__ . '/../../../../');

    if ($local && is_file($local . '/lf-boot/app.php')) {
        define('APP_PATH', $local);
    } else {
        $dir = getcwd();

        while ($dir !== false) {
            if (is_file($dir . '/lf-boot/app.php')) {
                define('APP_PATH', $dir);
                break;
            }

            $parent = dirname($dir);
            $dir = ($parent === $dir) ? false : $parent;
        }
    }
}

if (!defined('APP_PATH')) {
    fwrite(STDERR, "\nERROR: This is not a Laika project (lf-boot/app.php not found).\n");
    fwrite(STDERR, "Run \"worker\" from your Laika project root, or a sub-directory of it.\n\n");
    exit(1);
}

require APP_PATH . '/lf-boot/app.php';

$queue = $argv[1] ?? 'default';

// Job payloads are only unserialize()'d if their class is registered here —
// see Job::registerTrustedClasses(). List them in lf-config/queue.php
// ('trusted_job_classes' => [...]); read here via the framework's config()
// helper.
$trusted = array_filter((array) config('queue', 'trusted_job_classes', []));
if ($trusted) Job::registerTrustedClasses($trusted);

// Connection is a name -> config registry (see laikait/laika-model); PDO
// itself isn't opened until the driver first touches it. Laika\Model\Model
// would connect itself automatically anyway (its constructor calls
// Init::db($connection), which does exactly this same
// Connection::add(config('database', ...)) — see Laika\Core\Helper\Init)
// the moment DatabaseDriver below constructs QueueModel; adding it here
// upfront just makes the failure surface immediately instead of on first
// query, and keeps this script explicit about where its connection comes
// from.
Connection::add(config('database', 'default'));

$driver = new DatabaseDriver('default');
$failer = new DatabaseFailedJobProvider('default');

$worker = new Worker($driver, $failer);

fwrite(STDOUT, "[laika-queue] worker started on queue '{$queue}'\n");

$worker->work($queue);
