#!/usr/bin/env php
<?php

require __DIR__ . '/../vendor/autoload.php';

use Laika\Queue\Worker;
use Laika\Queue\Abstracts\Job;
use Laika\Queue\Driver\DatabaseDriver;
use Laika\Queue\Driver\DatabaseFailedJobProvider;
use Laika\Model\Connection;

$queue = $argv[1] ?? 'default';

// Job payloads are only unserialize()'d if their class is registered here —
// see Job::registerTrustedClasses(). Comma-separated list of fully-qualified
// Job subclass names, e.g. "App\\Jobs\\SendWelcomeEmail,App\\Jobs\\ChargeCard".
$trusted = array_filter(array_map('trim', explode(',', getenv('QUEUE_TRUSTED_JOB_CLASSES') ?: '')));
if ($trusted) {
    Job::registerTrustedClasses($trusted);
}

// Connection is a name -> config registry (see laikait/laika-model); PDO
// itself isn't opened until the driver first touches it. See Connection::add()
// for the full per-driver option set (mysql, pgsql, sqlite, sqlsrv, oci, firebird).
$config = ['driver' => getenv('DB_DRIVER') ?: 'mysql'];
if ($host = getenv('DB_HOST')) {
    $config['host'] = $host;
}
if ($port = getenv('DB_PORT')) {
    $config['port'] = (int) $port;
}
$config['database'] = getenv('DB_DATABASE') ?: '';
$config['username'] = getenv('DB_USER') ?: null;
$config['password'] = getenv('DB_PASS') ?: '';
if ($charset = getenv('DB_CHARSET')) {
    $config['charset'] = $charset;
}

Connection::add($config);

$driver = new DatabaseDriver('default');
$failer = new DatabaseFailedJobProvider('default');

$worker = new Worker($driver, $failer);

fwrite(STDOUT, "[laika-queue] worker started on queue '{$queue}'\n");

$worker->work($queue);
