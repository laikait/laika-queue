#!/usr/bin/env php
<?php

require __DIR__ . '/../vendor/autoload.php';

use Laika\Queue\Worker;
use Laika\Queue\Driver\DatabaseDriver;
use Laika\Queue\Driver\DatabaseFailedJobProvider;

$queue = $argv[1] ?? 'default';

$pdo = new PDO(
    getenv('DB_DSN'),
    getenv('DB_USER'),
    getenv('DB_PASS'),
    [PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION]
);

$driver = new DatabaseDriver($pdo);
$failer = new DatabaseFailedJobProvider($pdo);

$worker = new Worker($driver, $failer);

fwrite(STDOUT, "[laika-queue] worker started on queue '{$queue}'\n");

$worker->work($queue);
